USD_TO_RUB = 95.50

def convert_usd_to_rub(amount_usd):
    """Конвертирует доллары в рубли."""
    return amount_usd * USD_TO_RUB

usd = float(input("Введите сумму в долларах: "))
rub = convert_usd_to_rub(usd)
print(f"{usd:.2f} USD = {rub:.2f} RUB")



import math

def calculate_rectangle_area(width, height):
    """Возвращает площадь прямоугольника."""
    return width * height

def calculate_circle_area(radius):
    """Возвращает площадь круга."""
    return math.pi * (radius ** 2)

w = float(input("Ширина прямоугольника: "))
h = float(input("Высота прямоугольника: "))
print(f"Площадь прямоугольника: {calculate_rectangle_area(w, h):.2f}")

r = float(input("Радиус круга: "))
print(f"Площадь круга: {calculate_circle_area(r):.2f}")

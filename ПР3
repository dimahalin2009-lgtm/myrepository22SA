# 1. Создание переменных
a = 42
b = 3.14159
c = "Hello, Python!"
d = True
e = [1, 2, 3]
f = (4, 5, 6)
g = {"name": "Alice", "age": 30}
h = {7, 8, 9}
i = None



my_list = [1, 2, 3]
print("Исходный список:", my_list)  # [1, 2, 3]
my_list[0] = 100  # Изменяем первый элемент
print("Измененный список:", my_list)  # [100, 2, 3]
# Объяснение: Списки в Python являются изменяемыми (mutable). 
# Мы можем менять их элементы после создания.

my_tuple = (1, 2, 3)
print("Исходный кортеж:", my_tuple)  # (1, 2, 3)
# my_tuple[0] = 100  # Если раскомментировать, будет ошибка TypeError
# Объяснение: Кортежи являются неизменяемыми (immutable). 
# Python не позволяет изменять элементы кортежа после его создания. 
# При попытке это сделать возникнет ошибка TypeError.

my_string = "cat"
print("Исходная строка:", my_string)  # cat
# my_string[0] = 'b'  # Если раскомментировать, будет ошибка TypeError
# Объяснение: Строки в Python также неизменяемы (immutable). 
# Мы не можем изменить отдельный символ строки. 
# Чтобы получить новую строку, нужно создать её заново (например, my_string = 'b' + my_string[1:]).



try:
    num1_str = input("Введите первое число: ")
    num2_str = input("Введите второе число: ")
    num1 = int(num1_str)
    num2 = int(num2_str)
    result = num1 + num2
    print(f"Результат сложения: {result}")
except ValueError:
    print("Ошибка: Вы ввели не целое число. Пожалуйста, введите цифры (например, 5, а не 5.5 или abc).")



shopping_list = ["хлеб", "молоко", "сыр"]
shopping_list.append("яблоки")
print("Список покупок:", shopping_list)  # ['хлеб', 'молоко', 'сыр', 'яблоки']
unique_items = set(shopping_list)
print("Множество:", unique_items)  # {'сыр', 'молоко', 'яблоки', 'хлеб'} (порядок может быть разным)



student = {"name": "Иван",  "age": 20,   "course": 3,   "hobbies": ["программирование", "спорт"]}
print("Анкета студента:")
for key, value in student.items():
    print(f"{key}: {value}")
